PORT=4000
NODE_ENV=development

# MongoDB connection string (required — the app fails to start without it).
# For MongoDB Atlas: Database > Connect > Drivers, copy the connection
# string, and fill in your database user's password. Make sure your IP is
# allowed under Network Access first.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/socialsphere?retryWrites=true&w=majority

JWT_ACCESS_SECRET=changeme_access_secret
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# URL of the frontend app. Used to redirect the browser back after an OAuth
# login flow completes. Must match the host port the frontend is actually
# reachable on — check the `ports:` mapping for the `frontend` service in
# docker-compose.yml (default below assumes the committed 3000:3000). If
# you've changed that mapping (e.g. to dodge a port clash with another
# project), update this to match or the OAuth login redirect will land on
# whatever else is listening on the old port.
FRONTEND_URL=http://localhost:3000

# "Sign in with Google" (user login). Create OAuth 2.0 credentials at
# https://console.cloud.google.com/apis/credentials, add
# GOOGLE_REDIRECT_URI below as an authorized redirect URI, and set these.
# Leave blank to disable the Google login button (email/password + demo
# login still work).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/google/callback

# Only needed if you wire up real Meta OAuth. Leave blank to keep publishing
# in sandbox/simulator mode against the hardcoded demo accounts.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/v1/auth/oauth/meta/callback
META_GRAPH_API_VERSION=v20.0

AI_SERVICE_URL=http://ai-service:5001
